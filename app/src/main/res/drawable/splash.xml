<?xml version="1.0" encoding="utf-8"?>
<!-- Plain black behind the splash layout. The background image lives in activity_fullscreen
     (centerCrop), so it fills the screen in any orientation; a bitmap here was drawn at its
     natural size and showed as bands while the content faded in. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">
    <item android:drawable="@color/black" />

</layer-list>
