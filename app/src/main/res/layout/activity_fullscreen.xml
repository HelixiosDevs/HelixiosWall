<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.HelixiosWall.FullscreenContainer"
    tools:context=".FullscreenActivity"
    android:background="@color/black">

    <!-- The primary full-screen view. This can be replaced with whatever view
         is needed to present your content, e.g. VideoView, SurfaceView,
         TextureView, etc. -->

    <!-- This FrameLayout insets its children based on system windows using
     android:fitsSystemWindows. -->

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:alpha="0.15"
        android:scaleType="centerCrop"
        android:src="@drawable/background"
        android:tintMode="add"
        app:tint="#161e2a" />

    <ImageView
            android:id="@+id/logo_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="true"
            android:transitionName="shift_up"
            app:srcCompat="@drawable/heli_ico"
        android:visibility="invisible"/>

    <!-- Same size as heli_ico (272x70dp) so the last frame lines up with logo_1 for the
         shared-element hand-off, and the splash fits in portrait and landscape alike -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animationView"
        android:layout_width="272dp"
        android:layout_height="70dp"
        android:layout_gravity="center"
        app:lottie_rawRes="@raw/helixios_walls_reveal"
        app:lottie_enableMergePathsForKitKatAndAbove="true" />

    <ImageView
        android:id="@+id/invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible"/>

</FrameLayout>